{
	"files.associations": {
		".eslintrc": "jsonc",
		".prettierrc": "jsonc",
		".eslintignore": "ignore"
	},
	"files.exclude": {
		"**/.git": true,
		"**/.gitattributes": true,
		
	},

	"eslint.validate": [
		"javascript",
		"javascriptreact",
		"html",
		"typescriptreact"
	],

	"javascript.validate.enable": false,
	"javascript.format.enable": false,
	"typescript.format.enable": false,

	"search.exclude": {
		".git": true,
		".eslintcache": true,
		".misc/dll": true,
		"bun.lock": true,
		"out/{build,app/dist}": true,
		"node_modules": true,
		"npm-debug.log.*": true,
		"test/**/__snapshots__": true,
		"package-lock.json": true,
		"*.{css,sass,scss}.d.ts": true
	},
	"cSpell.words": [
		"wrb"
	]
}
