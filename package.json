{
	"name": "@wrb/wrb",
	"version": "1.0.0",
	"description": "A monorepo for deployment of cross platform applications to desktop using electron vite or to the web using web sockets",
	"repository": "git+https://github.com/ToneAr/wolfram-react-boilerplate",
	"author": "Antonis Aristeidou <tonya@wolfram.com>",
	"license": "MIT",
	"private": true,
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint . --fix",
		"test": "cd packages/frontend && bun run test",
		"dev:desktop": "cd packages/desktop && bun run dev",
		"dev:web": "cd packages/web && bun run dev",
		"build:desktop": "cd packages/desktop && bun run build",
		"build:web": "cd packages/web && bun run build",
		"build:wwe": "bun build:web",
		"package:linux": "cd packages/desktop && bun run build:linux",
		"package:win": "cd packages/desktop && bun run build:win",
		"package:mac": "cd packages/desktop && bun run build:mac",
		"start:desktop": "cd packages/desktop && bun run start",
		"start:web": "cd packages/web && bun run start",
		"start:wl": "cd packages/wolfram && bun run start"
	},
	"workspaces": [
		"packages/*"
	],
	"prettier": {
		"tabWidth": 4,
		"useTabs": true,
		"singleQuote": true
	},
	"dependencies": {
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-prettier": "^5.4.0",
		"globals": "^15.15.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^6.30.0",
		"typescript-eslint": "^8.32.0"
	},
	"devDependencies": {
		"@electron-toolkit/eslint-config-prettier": "^2.0.0",
		"@electron-toolkit/eslint-config-ts": "^2.0.0",
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/tsconfig": "^1.0.1",
		"@electron-toolkit/utils": "^3.0.0",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.26.0",
		"@types/node": "^20.17.37",
		"@types/react": "^18.3.20",
		"@types/react-dom": "^18.3.7",
		"@types/react-test-renderer": "^18.3.1",
		"@typescript-eslint/eslint-plugin": "^8.32.0",
		"@typescript-eslint/parser": "^8.32.0",
		"concurrently": "^9.1.2",
		"eslint": "^8.57.1",
		"eslint-import-resolver-typescript": "^3.10.1",
		"eslint-plugin-compat": "^4.2.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jest": "^27.9.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-promise": "^6.6.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^4.6.2",
		"prettier": "^3.5.3",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3",
		"cross-env": "^7.0.3",
		"vite-plugin-svgr": "^4.3.0",
		"vite-plugin-dts": "^4.5.3",
		"@vitejs/plugin-react": "^4.4.1",
		"@vituum/vite-plugin-postcss": "^1.1.0"
	}
}
